<Window x:Class="SaldanhaMoveisDesktop.SistemaERP"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="Saldanha Móveis - ERP Completo" Height="768" Width="1024" WindowStartupLocation="CenterScreen" Background="#0f0f0f">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <StackPanel Grid.Row="0" Background="#0f0f0f" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="SALDANHA MÓVEIS" Foreground="#D4AF37" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="ONDE O SUCESSO ACONTECE" Foreground="#888" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- ABAS DO SISTEMA (Background escuro para evitar bordas cinzas) -->
        <TabControl Grid.Row="1" Background="#141414" BorderThickness="0" Padding="0">

            <!-- ========================================== -->
            <!-- ABA 1: DASHBOARD GERENCIAL                 -->
            <!-- ========================================== -->
            <TabItem Header="Dashboard">
                <Grid Margin="20" Background="#141414">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Border Background="#222" CornerRadius="8" Padding="20" Margin="10" Width="200" BorderBrush="#D4AF37" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Faturamento (Mês)" Foreground="#ccc" FontSize="14"/>
                                <TextBlock x:Name="txtFaturamentoMes" Text="R$ 0,00" Foreground="#D4AF37" FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#222" CornerRadius="8" Padding="20" Margin="10" Width="200" BorderBrush="#ff4444" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Despesas (Mês)" Foreground="#ccc" FontSize="14"/>
                                <TextBlock x:Name="txtDespesasMes" Text="R$ 0,00" Foreground="#ff4444" FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#222" CornerRadius="8" Padding="20" Margin="10" Width="200" BorderBrush="#00ff00" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Lucro Líquido" Foreground="#ccc" FontSize="14"/>
                                <TextBlock x:Name="txtLucroMes" Text="R$ 0,00" Foreground="#00ff00" FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#222" CornerRadius="8" Padding="20" Margin="10" Width="150" BorderBrush="#333" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Vendas Hoje" Foreground="#ccc" FontSize="14"/>
                                <TextBlock x:Name="txtVendasHoje" Text="0" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- NOVO CARD: DESPESAS DE HOJE -->
                        <Border Background="#222" CornerRadius="8" Padding="20" Margin="10" Width="180" BorderBrush="#ff4444" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Despesas de Hoje" Foreground="#ccc" FontSize="14"/>
                                <TextBlock x:Name="txtDespesasHoje" Text="R$ 0,00" Foreground="#ff4444" FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Gráfico de Entradas -->
                        <Border Grid.Column="0" Background="#222" CornerRadius="8" Padding="15" Margin="10,0,10,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Faturamento dos últimos 7 dias" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                <lvc:CartesianChart x:Name="graficoSemana" Grid.Row="1" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Gráfico Receitas x Despesas -->
                        <Border Grid.Column="1" Background="#222" CornerRadius="8" Padding="15" Margin="10,0,10,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Receitas vs Despesas (Mês)" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                <lvc:PieChart x:Name="graficoMes" Grid.Row="1" InnerRadius="40" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- ABA 2: PAGAMENTO DE FUNCIONÁRIOS           -->
            <!-- ========================================== -->
            <TabItem Header="Pagamento de Funcionários">
                <Grid Margin="20" Background="#141414">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Controle de Pagamentos (RH)" Foreground="#D4AF37" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <StackPanel Margin="0,0,15,0" Width="200">
                            <TextBlock Text="Nome do Funcionário:" Foreground="#ccc" FontSize="12"/>
                            <TextBox x:Name="inputNomeFunc" Height="30" Background="#222" Foreground="White" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,15,0" Width="150">
                            <TextBlock Text="Cargo:" Foreground="#ccc" FontSize="12"/>
                            <TextBox x:Name="inputCargo" Height="30" Background="#222" Foreground="White" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,15,0" Width="120">
                            <TextBlock Text="Valor Pago (R$):" Foreground="#ccc" FontSize="12"/>
                            <TextBox x:Name="inputValorFunc" Height="30" Background="#222" Foreground="White" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,15,0" Width="100">
                            <TextBlock Text="Mês Ref.:" Foreground="#ccc" FontSize="12"/>
                            <TextBox x:Name="inputMesRef" Height="30" Background="#222" Foreground="White" VerticalContentAlignment="Center" ToolTip="Ex: 08/2026"/>
                        </StackPanel>

                        <Button x:Name="btnRegistrarFunc" Content="REGISTRAR PAGAMENTO" Click="ClicouRegistrarFuncionario" Background="#D4AF37" Foreground="Black" FontWeight="Bold" Height="30" Padding="10,0" VerticalAlignment="Bottom" Cursor="Hand"/>
                    </StackPanel>

                    <DataGrid x:Name="gridFuncionarios" Grid.Row="2" AutoGenerateColumns="False" Background="#1a1a1a" Foreground="White" BorderBrush="#333" RowBackground="#222" AlternatingRowBackground="#1a1a1a" HeadersVisibility="Column" GridLinesVisibility="None" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="1*"/>
                            <DataGridTextColumn Header="Funcionário" Binding="{Binding Nome}" Width="2*"/>
                            <DataGridTextColumn Header="Cargo" Binding="{Binding Cargo}" Width="1.5*"/>
                            <DataGridTextColumn Header="Ref." Binding="{Binding MesReferencia}" Width="1*"/>
                            <DataGridTextColumn Header="Valor Pago" Binding="{Binding Valor, StringFormat=C2}" Width="1.5*"/>

                            <DataGridTemplateColumn Header="Ações" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="✏️" Click="ClicouEditarFuncionario" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,5,0"/>
                                            <Button Content="🗑️" Click="ClicouExcluirFuncionario" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <TextBlock Text="Funcionários Pagos:" Foreground="#ccc" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtQtdPagos" Text="0" Foreground="White" FontSize="16" FontWeight="Bold" Margin="10,0,30,0" VerticalAlignment="Center"/>

                        <TextBlock Text="Total da Folha:" Foreground="#ccc" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTotalFolha" Text="R$ 0,00" Foreground="#ff4444" FontSize="18" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- ABA 3: CLIENTES                            -->
            <!-- ========================================== -->
            <TabItem Header="Clientes">
                <Grid Margin="20" Background="#141414">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Gestão de Clientes" Foreground="#D4AF37" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nome do Cliente:" Foreground="#ccc" FontSize="12" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="CPF / CNPJ:" Foreground="#ccc" FontSize="12" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Telefone:" Foreground="#ccc" FontSize="12" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Endereço:" Foreground="#ccc" FontSize="12" Margin="0,0,0,2"/>

                        <TextBox x:Name="inputNomeCliente" Grid.Row="1" Grid.Column="0" Height="30" Background="#222" Foreground="White" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="inputCpfCliente" Grid.Row="1" Grid.Column="1" Height="30" Background="#222" Foreground="White" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="inputTelefoneCliente" Grid.Row="1" Grid.Column="2" Height="30" Background="#222" Foreground="White" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="inputEnderecoCliente" Grid.Row="1" Grid.Column="3" Height="30" Background="#222" Foreground="White" VerticalContentAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
                        <Button Content="LIMPAR" Click="ClicouLimparCliente" Background="Transparent" Foreground="#888" BorderThickness="0" Margin="0,0,15,0" Cursor="Hand"/>
                        <Button Content="SALVAR CLIENTE" Click="ClicouSalvarCliente" Background="#D4AF37" Foreground="Black" FontWeight="Bold" Padding="15,8" Cursor="Hand"/>
                    </StackPanel>

                    <DataGrid x:Name="gridClientes" Grid.Row="3" AutoGenerateColumns="False" Background="#1a1a1a" Foreground="White" BorderBrush="#333" RowBackground="#222" AlternatingRowBackground="#1a1a1a" HeadersVisibility="Column" GridLinesVisibility="None" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="2*"/>
                            <DataGridTextColumn Header="CPF/CNPJ" Binding="{Binding CpfCnpj}" Width="1.5*"/>
                            <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="1.5*"/>
                            <DataGridTextColumn Header="Endereço" Binding="{Binding Endereco}" Width="3*"/>
                            <DataGridTemplateColumn Header="Ações" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="✏️" Click="ClicouEditarCliente" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,5,0"/>
                                            <Button Content="🗑️" Click="ClicouExcluirCliente" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- ABA 4: FORNECEDORES                        -->
            <!-- ========================================== -->
            <TabItem Header="Fornecedores">
                <Grid Margin="20" Background="#141414">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TÍTULO -->
                    <TextBlock Grid.Row="0" Text="Gestão de Fornecedores" Foreground="#D4AF37" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                    <!-- FORMULÁRIO -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nome Fantasia / Razão Social:" Foreground="#ccc" FontSize="12" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="CNPJ:" Foreground="#ccc" FontSize="12" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Telefone:" Foreground="#ccc" FontSize="12" Margin="0,0,0,2"/>

                        <TextBox x:Name="inputNomeFornecedor" Grid.Row="1" Grid.Column="0" Height="30" Background="#222" Foreground="White" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="inputCnpjFornecedor" Grid.Row="1" Grid.Column="1" Height="30" Background="#222" Foreground="White" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="inputTelefoneFornecedor" Grid.Row="1" Grid.Column="2" Height="30" Background="#222" Foreground="White" VerticalContentAlignment="Center"/>
                    </Grid>

                    <!-- BOTÕES DE AÇÃO -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
                        <Button Content="LIMPAR" Click="ClicouLimparFornecedor" Background="Transparent" Foreground="#888" BorderThickness="0" Margin="0,0,15,0" Cursor="Hand"/>
                        <Button Content="SALVAR FORNECEDOR" Click="ClicouSalvarFornecedor" Background="#D4AF37" Foreground="Black" FontWeight="Bold" Padding="15,8" Cursor="Hand"/>
                    </StackPanel>

                    <!-- TABELA DE FORNECEDORES -->
                    <DataGrid x:Name="gridFornecedores" Grid.Row="3" AutoGenerateColumns="False" Background="#1a1a1a" Foreground="White" BorderBrush="#333" RowBackground="#222" AlternatingRowBackground="#1a1a1a" HeadersVisibility="Column" GridLinesVisibility="None" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Empresa / Nome Fantasia" Binding="{Binding NomeFantasia}" Width="2*"/>
                            <DataGridTextColumn Header="CNPJ" Binding="{Binding Cnpj}" Width="1.5*"/>
                            <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="1.5*"/>
                            <DataGridTemplateColumn Header="Ações" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="✏️" Click="ClicouEditarFornecedor" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,5,0"/>
                                            <Button Content="🗑️" Click="ClicouExcluirFornecedor" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- ABA 5: PRODUTOS                            -->
            <!-- ========================================== -->
            <TabItem Header="Produtos">
                <Grid Margin="20" Background="#141414">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Gestão de Produtos e Estoque" Foreground="#D4AF37" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nome do Produto:" Foreground="#ccc" FontSize="12" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Fornecedor:" Foreground="#ccc" FontSize="12" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Preço de Custo (R$):" Foreground="#ccc" FontSize="12" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Preço de Venda (R$):" Foreground="#ccc" FontSize="12" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Qtd. Estoque:" Foreground="#ccc" FontSize="12" Margin="0,0,0,2"/>

                        <TextBox x:Name="inputNomeProduto" Grid.Row="1" Grid.Column="0" Height="30" Background="#222" Foreground="White" VerticalContentAlignment="Center" Margin="0,0,10,0"/>

                        <!-- ComboBox de Fornecedor Editável -->
                        <ComboBox x:Name="comboFornecedorProduto" Grid.Row="1" Grid.Column="1" 
                                  DisplayMemberPath="NomeFantasia" SelectedValuePath="Id" 
                                  IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                  Height="30" Background="#222" Foreground="White" VerticalContentAlignment="Center" Margin="0,0,10,0"/>

                        <TextBox x:Name="inputPrecoCusto" Grid.Row="1" Grid.Column="2" Height="30" Background="#222" Foreground="White" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="inputPrecoVenda" Grid.Row="1" Grid.Column="3" Height="30" Background="#222" Foreground="White" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="inputQtdEstoque" Grid.Row="1" Grid.Column="4" Height="30" Background="#222" Foreground="White" VerticalContentAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
                        <Button Content="LIMPAR" Click="ClicouLimparProduto" Background="Transparent" Foreground="#888" BorderThickness="0" Margin="0,0,15,0" Cursor="Hand"/>
                        <Button Content="SALVAR PRODUTO" Click="ClicouSalvarProduto" Background="#D4AF37" Foreground="Black" FontWeight="Bold" Padding="15,8" Cursor="Hand"/>
                    </StackPanel>

                    <DataGrid x:Name="gridProdutos" Grid.Row="3" AutoGenerateColumns="False" Background="#1a1a1a" Foreground="White" BorderBrush="#333" RowBackground="#222" AlternatingRowBackground="#1a1a1a" HeadersVisibility="Column" GridLinesVisibility="None" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Produto" Binding="{Binding Nome}" Width="2*"/>
                            <DataGridTextColumn Header="Fornecedor" Binding="{Binding Fornecedor.NomeFantasia, FallbackValue='Sem Fornecedor'}" Width="2*"/>
                            <DataGridTextColumn Header="Custo (R$)" Binding="{Binding PrecoCusto, StringFormat=C2}" Width="1.5*"/>
                            <DataGridTextColumn Header="Venda (R$)" Binding="{Binding PrecoVenda, StringFormat=C2}" Width="1.5*"/>
                            <DataGridTextColumn Header="Estoque" Binding="{Binding QuantidadeEstoque}" Width="1*"/>
                            <DataGridTemplateColumn Header="Ações" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="✏️" Click="ClicouEditarProduto" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,5,0"/>
                                            <Button Content="🗑️" Click="ClicouExcluirProduto" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- ABA 6: DESPESAS                            -->
            <!-- ========================================== -->
            <TabItem Header="Despesas">
                <Grid Margin="20" Background="#141414">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Despesas Diárias" Foreground="#D4AF37" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                    <!-- FORMULÁRIO -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <StackPanel Margin="0,0,15,0" Width="300">
                            <TextBlock Text="Descrição (ex: gasolina fiorino, café):" Foreground="#ccc" FontSize="12"/>
                            <TextBox x:Name="inputDescricaoDespesa" Height="30" Background="#222" Foreground="White" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,15,0" Width="120">
                            <TextBlock Text="Valor (R$):" Foreground="#ccc" FontSize="12"/>
                            <TextBox x:Name="inputValorDespesa" Height="30" Background="#222" Foreground="White" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <Button Content="LANÇAR DESPESA" Click="ClicouSalvarDespesa" Background="#ff4444" Foreground="White" FontWeight="Bold" Height="30" Padding="15,0" VerticalAlignment="Bottom" Cursor="Hand"/>
                    </StackPanel>

                    <!-- TABELA DE DESPESAS -->
                    <DataGrid x:Name="gridDespesas" Grid.Row="2" AutoGenerateColumns="False" Background="#1a1a1a" Foreground="White" RowBackground="#222" AlternatingRowBackground="#1a1a1a" IsReadOnly="True" BorderBrush="#333" HeadersVisibility="Column" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding DataCadastro, StringFormat=dd/MM/yyyy HH:mm}" Width="1.5*"/>
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="3*"/>
                            <DataGridTextColumn Header="Valor (R$)" Binding="{Binding Valor, StringFormat=C2}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- ABA 7: PONTO DE VENDA (PDV)                -->
            <!-- ========================================== -->
            <TabItem Header="Ponto de Venda">
                <Grid Margin="20" Background="#141414">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="Registrar Venda" Foreground="#D4AF37" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                        <TextBlock Text="Selecione o Cliente:" Foreground="#ccc" Margin="0,0,0,5"/>
                        <ComboBox x:Name="comboClientesPdv" DisplayMemberPath="Nome" SelectedValuePath="Id" Height="35" Margin="0,0,0,15" Background="#222" Foreground="White"/>

                        <TextBlock Text="Adicionar Produto:" Foreground="#ccc" Margin="0,0,0,5"/>
                        <ComboBox x:Name="comboProdutosPdv" DisplayMemberPath="Nome" SelectedValuePath="Id" Height="35" Margin="0,0,0,15" Background="#222" Foreground="White"/>

                        <TextBlock Text="Quantidade:" Foreground="#ccc" Margin="0,0,0,5"/>
                        <TextBox x:Name="inputQtdPdv" Text="1" Height="35" Margin="0,0,0,20" Background="#222" Foreground="White" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="16"/>

                        <Button Content="ADICIONAR AO CARRINHO" Click="ClicouAdicionarAoCarrinho" Background="#D4AF37" Foreground="Black" FontWeight="Bold" Height="40" Cursor="Hand"/>
                    </StackPanel>

                    <Grid Grid.Column="1" Background="#1a1a1a" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Carrinho de Compras" Foreground="White" FontSize="18" FontWeight="Bold" Margin="15"/>

                        <DataGrid x:Name="gridCarrinho" Grid.Row="1" AutoGenerateColumns="False" Background="Transparent" Foreground="White" BorderBrush="Transparent" RowBackground="#222" AlternatingRowBackground="#1a1a1a" HeadersVisibility="Column" GridLinesVisibility="None" IsReadOnly="True" Margin="15,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produto" Binding="{Binding Produto.Nome}" Width="2*"/>
                                <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade}" Width="0.8*"/>
                                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C2}" Width="1.5*"/>
                                <DataGridTemplateColumn Header="Remover" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="❌" Click="ClicouRemoverDoCarrinho" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- OPÇÕES DE PAGAMENTO, DESCONTO E FRETE -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="15,15,15,10">
                            <StackPanel Margin="0,0,15,0">
                                <TextBlock Text="Forma de Pagamento:" Foreground="#ccc" FontSize="12"/>
                                <ComboBox x:Name="comboFormaPagamento" Width="160" Height="30" Background="#222" Foreground="White" SelectedIndex="0">
                                    <ComboBoxItem Content="À Vista (Dinheiro/Pix)"/>
                                    <ComboBoxItem Content="Cartão de Crédito"/>
                                    <ComboBoxItem Content="Cartão de Débito"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,15,0">
                                <TextBlock Text="Desconto (R$):" Foreground="#ccc" FontSize="12"/>
                                <TextBox x:Name="inputDescontoVenda" Width="100" Height="30" Background="#222" Foreground="White" Text="0" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Frete (R$):" Foreground="#ccc" FontSize="12"/>
                                <TextBox x:Name="inputFreteVenda" Width="100" Height="30" Background="#222" Foreground="White" Text="0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Background="#222" Padding="15">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
                                <TextBlock Text="Total:" Foreground="#ccc" FontSize="18" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtTotalVenda" Text="R$ 0,00" Foreground="#00ff00" FontSize="28" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="FINALIZAR VENDA" Click="ClicouFinalizarVenda" Background="#00ff00" Foreground="Black" FontWeight="Bold" FontSize="16" Height="45" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>